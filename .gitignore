# build output
build/
*.o
*.map
*.elf

# rust harness build dir
tools/harness/target/

# ROMS and ROM related files
*.gba
*.sav
*.ss?
*.sa?
*.sg?
*.SNA

# compressed textscript build intermediates (generated by `make assets`);
# path-independent so they stay ignored regardless of where the tree moves.
# (source blobs are plain *.bin and stay tracked; generated ones are *.s.bin)
**/backup_lz/
*.s.lz
*.s.bin

# atom-specific settings
.atom*
*.json

# python generated files/folders
__pycache__/

# compiled python bytecode files
*.pyc

# clion settings
.idea/

# cache files for heavy computations
.cache/

# vim files
*.swp
*.swo
*.sw*
tags

# intentionally ignore those junk/temp files
*.ign

# compare.sh and other misc dumps
baserom.txt
bn6f.txt
*.txt

# asmdiff.sh
*.dump

# tools
*.exe
tools/agbcc/
tools/agbcc-src/
tools/binutils/
*.pickle
temp/
*.cfg
*.rsync
*.sym
